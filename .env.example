# ==========================================
# ROOT ENV EXAMPLE
# Note: You should copy this to backend/.env
# ==========================================

PORT=3001

# Database
DATABASE_URL="postgresql://outbox_user:outbox_password@localhost:5433/outbox_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# Ethereal Email (Fake SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user
SMTP_PASS=your_ethereal_password

# Authentication (Google OAuth)
JWT_SECRET=super_secret_jwt_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Rate Limiting & Worker Concurrency
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
